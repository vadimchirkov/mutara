{
  "name": "teob-mutara",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Universal optimizer that proves its gains: improves prompts, strategies and parameters, keeps only changes that win on unseen data, and resumes after crashes without paying twice.",
  "repository": {
    "type": "git",
    "url": "https://github.com/vadimchirkov/mutara.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.14.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./optimizer": {
      "types": "./dist/optimizer.d.ts",
      "import": "./dist/optimizer.js"
    },
    "./reflective": {
      "types": "./dist/reflective.d.ts",
      "import": "./dist/reflective.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "skills/mutara",
    "examples/minimal.mjs",
    "examples/reflective-demo.mjs",
    "examples/prompt-gate/*.mjs",
    "examples/prompt-gate/proposals.json",
    "examples/prompt-gate/fixtures/*.json",
    "examples/prompt-gate/README.md",
    "bin"
  ],
  "scripts": {
    "play": "tsx examples/alchemy/src/play.ts",
    "offline": "tsx examples/alchemy/src/offline.ts",
    "bench": "tsx examples/alchemy/src/run.ts",
    "bench:semantic": "tsx examples/alchemy/src/semantic-bench.ts",
    "bench:learning": "tsx examples/alchemy/src/learning/bench.ts",
    "bench:components": "tsx examples/alchemy/src/learning/bench.ts --components",
    "q4": "tsx examples/alchemy/src/q4-control.ts",
    "test": "pnpm run build && vitest run",
    "typecheck": "pnpm run build && tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "demo": "pnpm run build && node examples/minimal.mjs",
    "demo:reflective": "pnpm run build && node examples/reflective-demo.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@lambda-house/teob-ts": "0.4.2"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "better-sqlite3": "^12.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "bin": {
    "mutara": "./bin/mutara.mjs"
  }
}
